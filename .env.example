# Hugging Face User Access Token (Free)
# Obtain a free read token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_free_token_here

# Optional: Default Model ID (Open-weight model on Hugging Face)
# Default is Google's Gemma 2 2B Instruct (fits the HF26 Hacktoberfest "Best Use of Gemma" category)
# Recommended alternatives: meta-llama/Llama-3.2-3B-Instruct, Qwen/Qwen2.5-7B-Instruct
DEFAULT_MODEL=google/gemma-2-2b-it
